---
import App from "../layouts/App.astro";
import Mark from "../components/Mark.astro";
---

<App title="Add passkey · opencash">
  <main class="dash pay">
    <div class="pay__card">
      <div class="pay__head">
        <a class="wordmark" href="/"><Mark />open<span>cash</span></a>
        <span class="tag" data-addkey-state>Waiting</span>
      </div>
      <div class="card">
        <span class="panel__label">Add your opencash passkey to</span>
        <b class="company__name mono" data-addkey-account>—</b>
        <p class="panel__lede" style="margin-top:var(--sp-sm)">Your wallet will ask you to add a full-access key. Approve it only if you just started opening opencash on your own phone, and the key below matches the one shown in the app.</p>
        <code class="mono" style="display:block;margin-top:var(--sp-sm);word-break:break-all" data-addkey-key>—</code>
        <div class="btn-row" style="margin-top:var(--sp-md)">
          <button type="button" class="btn btn--primary" data-addkey-go>Connect wallet and approve</button>
        </div>
      </div>
      <p class="status-line" data-addkey-message role="status"></p>
      <p class="pay__trust">Your wallet signs one transaction that adds this key to your own account. opencash never sees your wallet keys.</p>
    </div>
  </main>
  <script>
    import "../scripts/addkey/index";
  </script>
</App>
